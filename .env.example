TTS_PROVIDER=piper
OPENAI_API_KEY=
PIPER_VOICES_DIR=voices
PIPER_VOICE=ar_JO-kareem-medium

LLM_PROVIDER=ollama
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# small/cpu is the safe portable default. If you have an NVIDIA GPU, WHISPER_DEVICE=cuda +
# WHISPER_MODEL_SIZE=medium (or larger) is much more accurate, especially for Arabic dialects.
# On Pascal-generation GPUs (10-series) use WHISPER_COMPUTE_TYPE=int8 - float16/int8_float16 aren't
# efficiently supported there.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=ar

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sttordering
