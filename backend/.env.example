# ═══════════════════════════════════════════════
# Environment Variables — Voice Ordering Backend
# ═══════════════════════════════════════════════

# ─── App Settings ───
APP_NAME=Voice Ordering API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ─── Database (PostgreSQL + pgvector) ───
# Same as docker-compose.yml — don't change unless you know why
DB_HOST=postgres
DB_PORT=5432
DB_NAME=voice_ordering
DB_USER=voice_user
DB_PASSWORD=voice_pass_2026
DB_URL=postgresql+asyncpg://voice_user:voice_pass_2026@postgres:5432/voice_ordering

# ─── Redis ───
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass_2026
REDIS_URL=redis://:redis_pass_2026@redis:6379/0

# ─── API Settings ───
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# ─── Sync Service ───
SYNC_INTERVAL_MINUTES=15
RESTAURANT_ENGINE_BASE_URL=https://api.restaurant-engine.example.com
RESTAURANT_ENGINE_API_KEY=your_api_key_here

# ─── CORS ───
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Security (Placeholder for Phase 3+) ───
SECRET_KEY=change-this-in-production-super-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=60
